# Port config
SERVING_API_KEY=token

# Hybrid serving (SPLADE + Qwen3 side by side, see docker/hybrid_compose_serving.yml)
TEI_SPARSE_EMBEDDING_PORT=8101
TEI_DENSE_EMBEDDING_PORT=8100
SPARSE_MODEL_NAME=opensearch-project/opensearch-neural-sparse-encoding-multilingual-v1
DENSE_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# TEI serving tuning (see: text-embeddings-router --help)
TEI_DTYPE=float16
TEI_MAX_BATCH_TOKENS=16384
TEI_MAX_CONCURRENT_REQUESTS=512
TEI_PAYLOAD_LIMIT=2000000

# Optional: Hugging Face token, needed for gated/private models or to raise rate limits
HF_TOKEN=