# Port config
VLLM_EMBEDDING_PORT=8100
# Model config
EMBEDDING_MODEL_NAME=
EMBEDDING_GPU_MEM_UTIL=0.6
SERVING_API_KEY=token

# Hybrid serving (bge-m3 + qwen3 side by side, see docker/hybrid_compose_serving.yml)
VLLM_BGE_PORT=8100
VLLM_QWEN3_PORT=8101
BGE_MODEL_NAME=BAAI/bge-m3
QWEN3_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
BGE_GPU_MEM_UTIL=0.4
QWEN3_GPU_MEM_UTIL=0.4